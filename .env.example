# Copy to .env or export variables. Never commit credentials.
STUDIO_DATA_DIR=data/v2
STUDIO_MODEL_MODE=extractive
# Default: native in extractive mode; deeppresenter in API mode.
# STUDIO_ENGINE=deeppresenter
# Set STUDIO_ENGINE=native to explicitly use the original Studio composer.
# Switch to api after filling all model metadata below.
STUDIO_MODEL_BASE_URL=
STUDIO_MODEL_ID=
STUDIO_MODEL_API_KEY=
STUDIO_MODEL_PARAMETERS_B=0
STUDIO_MODEL_OPEN_WEIGHTS=false
STUDIO_MODEL_LICENSE=
STUDIO_STAGE=selection
# Final requires an explicit operator-configured VK endpoint allowlist.
STUDIO_VK_ALLOWED_HOSTS=
STUDIO_MODEL_CONCURRENCY=1
# Optional provider-specific settings; unset thinking uses the provider default.
# STUDIO_MODEL_THINKING=false
STUDIO_MODEL_STRUCTURED_OUTPUT=false
# Opt in only after authorizing template raster backgrounds and rendered slide PNGs
# to the configured provider. Review uses the same vision-capable model.
# An unavailable/failed review makes API results needs_review, never a silent pass.
STUDIO_VLM_ENABLED=false
# During preparation only: exact static OFL TTF from Google Fonts repo or CSS API.
# No document URLs or commercial fonts; false disables network font lookup.
STUDIO_DOWNLOAD_FONTS=true
# Optional Node.js executable for compressed EOT/MTX fonts; otherwise use node in PATH.
# STUDIO_NODE_EXECUTABLE=/absolute/path/to/node
# Alternative names supported when corresponding STUDIO_MODEL_* values are empty:
# LLM_API_KEY=replace-locally
# LLM_CHAT_COMPLETIONS_URL=https://your-provider.example/v1/chat/completions
# LLM_MODEL=your-open-weight-model
STUDIO_PORT=8765
# Inbound Host-header allowlist (comma-separated). Default: local only —
# 127.0.0.1,localhost,::1. For a server deployment list the public hostname/IP
# as the browser sees it, e.g. STUDIO_ALLOWED_HOSTS=demo.example.com,203.0.113.10
# "*" disables the check (only behind a reverse proxy that validates Host).
# STUDIO_ALLOWED_HOSTS=
# Optional absolute LibreOffice executable; otherwise discover soffice automatically.
# STUDIO_SOFFICE=/absolute/path/to/soffice

# OpenRouter migration (selection stage): use a dedicated key; old LLM key is not forwarded.
# STUDIO_MODEL_BASE_URL=https://openrouter.ai/api/v1
# STUDIO_MODEL_ID=qwen/qwen3.8-27b
# OPENROUTER_API_KEY=replace-locally
# STUDIO_MODEL_THINKING=false
# STUDIO_MODEL_STRUCTURED_OUTPUT=false
# Alibaba currently supports JSON mode; schemas remain mandatory in server validation.
# STUDIO_OPENROUTER_PROVIDERS=alibaba
# STUDIO_OPENROUTER_ALLOW_FALLBACKS=false
# Requests require support for the requested JSON/reasoning parameters.
